# ─────────────────────────────────────────────────────────────
# GrowthPilot AI — Backend Environment Configuration Example
# ─────────────────────────────────────────────────────────────

# Server Port (Render sets this dynamically via process.env.PORT)
PORT=5000

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=growthpilotAI
DB_NAME=growthpilotAI

# JWT Secret for User Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Default Admin Credentials
ADMIN_EMAIL=admin@growthpilot.ai
ADMIN_PASSWORD=YourAdminPassword123!

# Brevo (Sendinblue) Transactional Email API (for OTPs, alerts)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_email@domain.com
BREVO_SENDER_NAME=GrowthPilot AI

# ─────────────────────────────────────────────────────────────
# Cloud AI Provider Setup (NVIDIA / Groq Ultra-Fast)
# ─────────────────────────────────────────────────────────────
# Set primary AI provider: 'groq' (super fast sub-second) or 'nvidia'
AI_PROVIDER=groq
USE_GROQ_API=true
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# NVIDIA API Configuration (build.nvidia.com)
USE_NVIDIA_API=true
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=minimaxai/minimax-m3.1-flash
NVIDIA_TEMPERATURE=0.7
NVIDIA_MAX_TOKENS=1024
NVIDIA_TIMEOUT=15000

# ─────────────────────────────────────────────────────────────
# Local / Ngrok LLM — Text Generation (Optional)
# ─────────────────────────────────────────────────────────────
# Set to 'true' if running a local LLM or tunneling through ngrok
USE_LOCAL_LLM=false

# For Local Development on your computer:
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1

# For Production (e.g. Render) communicating with your local computer via ngrok:
# LOCAL_LLM_BASE_URL=https://<your-ngrok-subdomain>.ngrok-free.dev/v1
LOCAL_LLM_BASE_URL=https://escalator-fidgeting-payback.ngrok-free.dev/v1

# Active model identifier (auto-detected if omitted)
LOCAL_LLM_MODEL=qwen2.5-coder-3b-instruct-q4_k_m.gguf
LOCAL_LLM_TEMPERATURE=0.7
LOCAL_LLM_MAX_TOKENS=400
LOCAL_LLM_TIMEOUT=120000

# Optional: Bearer token if your LLM server or ngrok endpoint is protected
# LOCAL_LLM_API_KEY=your_optional_tunnel_token

# ─────────────────────────────────────────────────────────────
# Cloud Fallback Providers (Optional, used if Local LLM is offline)
# ─────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AQ.your_gemini_api_key_here
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
USE_GEMINI_IMAGE_GENERATION=true

# Google OAuth 2.0 (for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
