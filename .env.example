PORT=5000
MONGODB_URI=your_mongodb_connection_string
DB_NAME=growthpilotAI
JWT_SECRET=your_jwt_secret

ADMIN_EMAIL=admin@growthpilot.ai
ADMIN_PASSWORD=your_admin_password

BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_email@gmail.com
BREVO_SENDER_NAME=GrowthPilot AI

AI_PROVIDER=groq
USE_GROQ_API=true
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

USE_NVIDIA_API=true
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=minimaxai/minimax-m3.1-flash
NVIDIA_TIMEOUT=15000

USE_LOCAL_LLM=false

USE_GEMINI_IMAGE_GENERATION=true
GEMINI_API_KEY=your_gemini_api_key
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
